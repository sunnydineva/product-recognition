# Copy to repository-root .env for Compose and Python services.
YOLO_PORT=8000
DINOV2_PORT=18102
DINOV2_RECOGNIZE_URL=http://127.0.0.1:18102/recognize
DINOV2_TIMEOUT=10
POSTGRES_DB=product_recognition
POSTGRES_USER=product_user
POSTGRES_PASSWORD=change_me
# Fresh volumes: product_user is infrastructure admin; AI uses its own role.
# Existing volumes: read infrastructure/database/README.md BEFORE changing roles.
AI_DB_USER=ai_service
AI_DB_PASSWORD=change_me_ai
DATABASE_URL=postgresql://ai_service:change_me_ai@127.0.0.1:5432/product_recognition
INVENTORY_DB=inventory
INVENTORY_DB_USER=inventory_service
INVENTORY_DB_PASSWORD=change_me_inventory
# Host-run inventory; Compose supplies a postgres:5432 URL instead.
INVENTORY_DATASOURCE_URL=jdbc:postgresql://localhost:5432/inventory
CLOUDFLARED_CREDENTIALS_FILE=/home/sunny/.cloudflared/xxx-xxx-xx-xx-xxx.json
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
SCHEMA_REGISTRY_URL=http://localhost:8087
